# Immich .env テンプレート — VE1用ドラフト
# 実際の値を入れた .env は .gitignore 対象 (秘密情報をコミットしない)。
# 使い方: cp immich.env.example .env  →  .env を編集

# NFS (VE2 TrueNAS: tank/pic_tank) のマウント先。docs/ve1-immich-build.md Step 6 で作成
UPLOAD_LOCATION=/mnt/nfs/pic_tank

# ssd-thin から切り出したディスクのマウント先。docs/ve1-immich-build.md Step 7 で作成
# ⚠️ マウントポイント直下ではなくサブディレクトリを指定すること (lost+foundでinitdbが失敗する、2026-08-04実測)
DB_DATA_LOCATION=/mnt/ssd-pgdata/postgres

# タイムゾーン
TZ=Asia/Tokyo

# イメージバージョン (releaseで最新安定版を追従。固定したい場合はタグを指定)
IMMICH_VERSION=release

# Postgres — DB_PASSWORDは必ず強固なランダム値に変更すること (このファイルには絶対に実値を書かない)
DB_USERNAME=immich
DB_DATABASE_NAME=immich
DB_PASSWORD=CHANGE_ME
